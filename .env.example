# Netlify frontend: Render-serverens offentlige WSS-adresse.
VITE_MULTIPLAYER_WS_URL=wss://DIN-RENDER-SERVICE.onrender.com/ws

# Render server: Netlify-sidens præcise HTTPS-origin.
ALLOWED_ORIGIN=https://DIT-SITE.netlify.app

# Sæt til true i produktion, så serveren ikke starter uden origin-beskyttelse.
REQUIRE_ALLOWED_ORIGIN=true

# Render server: hemmelig adgangskode til oprettelse af lærerum.
TEACHER_ACCESS_CODE=DIN-LAERER-ADGANGSKODE
